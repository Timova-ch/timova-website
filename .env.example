# Timova Website: Umgebungsvariablen (Werte nie ins Repo)

# Schlüssel «timova-website» von Resend. Ohne Wert werden Anfragen lokal
# nur protokolliert (Testmodus); auf Vercel antwortet das Formular dann mit
# einem Hinweis auf info@timova.ch.
RESEND_API_KEY=

# Erst auf true setzen, wenn alle Platzhalter (docs/OFFEN.md) gefüllt sind.
# Alles andere bedeutet noindex.
SITE_INDEXIERBAR=
